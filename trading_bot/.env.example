# ============================================================
#  Multi-Agent Trading Bot — environment configuration
#  Αντίγραψε σε .env:  cp .env.example .env
# ============================================================

# --- Execution safety -------------------------------------------------
# true  -> dry-run / paper trading (κανένα πραγματικό order, μόνο journal)
# false -> live (στέλνει πραγματικά orders αν υπάρχουν keys)
DRY_RUN=true

# Binance testnet (χρησιμοποιείται μόνο όταν DRY_RUN=false)
BINANCE_TESTNET=true
# spot (testnet.binance.vision — geo-blocked σε ορισμένα clouds) ή
# futures (testnet.binancefuture.com — προσβάσιμο ευρύτερα). Ξεχωριστά keys!
BINANCE_MARKET=spot
BINANCE_QUOTE=USDT

# --- Binance API ------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Anthropic (Claude) — Polymarket agent + prompt tuning ------------
ANTHROPIC_API_KEY=

# --- Polymarket CLOB --------------------------------------------------
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# προαιρετικά market ids (comma-separated) προς παρακολούθηση
POLYMARKET_MARKETS=

# --- TradingView webhook ----------------------------------------------
# κοινό secret· τα alerts πρέπει να υπογράφουν το body (HMAC-SHA256)
TV_WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Live Trader Agent (auto-scanner) ---------------------------------
# universe που σκανάρει 24/7 (stocks/ETFs/crypto, μέσω Yahoo)
LIVE_UNIVERSE=GLD,TLT,IWM,NVDA
LIVE_INTERVAL=1d
LIVE_POLL=300

# --- Optimization Agent -----------------------------------------------
# τρέχει κάθε N κλεισμένα trades Ή κάθε M ώρες (όποιο έρθει πρώτο)
OPTIMIZE_EVERY_TRADES=50
OPTIMIZE_EVERY_HOURS=168

# --- Paths ------------------------------------------------------------
CONFIG_PATH=config.json
DB_PATH=trading.db
LOG_PATH=trading.log
